import java_cup.runtime.*;
import java.util.*;

parser code {: :};
action code {: :};

/* ========================================================================
   TERMINAL SYMBOLS
   ======================================================================== */

/* Keywords */
terminal CLASS, FINAL, INT, CHAR, BOOL, FLOAT, VOID;
terminal IF, ELSE, WHILE, READ, PRINT, PRINTLINE, RETURN;
terminal TRUE, FALSE;

/* Operators */
terminal AND, OR, NOT;
terminal PLUS, MINUS, MULT, DIV;
terminal LT, GT, LE, GE, EQEQ, NE;
terminal INC, DEC;
terminal EQ, QMARK, COLON;

/* Punctuation */
terminal SEMI, COMMA;
terminal LPAREN, RPAREN;
terminal LBRACKET, RBRACKET;
terminal LBRACE, RBRACE;

/* Literals and Identifiers */
terminal String ID;
terminal String INTLIT;
terminal String FLOATLIT;
terminal String CHARLIT;
terminal String STRLIT;

/* Error token */
terminal ERROR;

/* ========================================================================
   NON-TERMINAL SYMBOLS
   ======================================================================== */

/* Phase 2: Program structure */
non terminal Program program;
non terminal FieldDeclList fielddecls;
non terminal FieldDecl fielddecl;
non terminal MethodDeclList methoddecls;
non terminal MethodDecl methoddecl;
non terminal Type type;
non terminal ParamList params;
non terminal ParamList param_list;
non terminal ParamDecl param;

/* Phase 1: Statements and expressions (unchanged) */
non terminal StmtList stmts;
non terminal Stmt stmt;
non terminal Stmt block;
non terminal Stmt if_end;
non terminal Expr expr;
non terminal Expr name;

/* Helper non-terminals */
non terminal String type_name;
non terminal java.util.ArrayList expr_list;
non terminal java.util.ArrayList name_list;
non terminal java.util.ArrayList printline_args;

/* ========================================================================
   OPERATOR PRECEDENCE
   (Same as Phase 1)
   ======================================================================== */

precedence right QMARK, COLON;
precedence left OR;
precedence left AND;
precedence left EQEQ, NE;
precedence left LT, LE, GT, GE;
precedence left PLUS, MINUS;
precedence left MULT, DIV;
precedence right NOT;

/* ========================================================================
   START SYMBOL
   ======================================================================== */

start with program;

/* ========================================================================
   PHASE 2 GRAMMAR: CLASS STRUCTURE
   ======================================================================== */

/**
 * Program ::= class id { Fielddecls Methoddecls }
 * 
 * The root of the AST.
 * A program is a single class with fields and methods.
 */
program ::= 
    CLASS ID:name LBRACE fielddecls:f methoddecls:m RBRACE
    {: RESULT = new Program(name, f, m); :}
    ;

/**
 * Fielddecls ::= Fielddecl Fielddecls | ε
 * 
 * Zero or more field declarations.
 * Left-recursive to build list in correct order (using prepend).
 */
fielddecls ::=
    fielddecl:f fielddecls:fs
    {: fs.prepend(f); RESULT = fs; :}
  | /* empty */
    {: RESULT = new FieldDeclList(); :}
    ;

/**
 * Fielddecl ::= Type id ;
 *             | Type id [ intlit ] ;
 *             | Type id = Expr ;
 *             | final Type id = Expr ;
 * 
 * Field/variable declarations in four forms:
 * 1. Simple: int x;
 * 2. Array: int arr[10];
 * 3. With initializer: float a = 3.14;
 * 4. Final with initializer: final int CONST = 5;
 */
fielddecl ::=
    type:t ID:name SEMI
    {: RESULT = new FieldDecl(t, name); :}
    
  | type:t ID:name LBRACKET INTLIT:size RBRACKET SEMI
    {: RESULT = new FieldDecl(t, name, Integer.parseInt(size)); :}
    
  | type:t ID:name EQ expr:e SEMI
    {: RESULT = new FieldDecl(t, name, e); :}
    
  | FINAL type:t ID:name EQ expr:e SEMI
    {: RESULT = new FieldDecl(true, t, name, e); :}
    ;

/**
 * Methoddecls ::= Methoddecl Methoddecls | ε
 * 
 * Zero or more method declarations.
 * Left-recursive to build list in correct order (using prepend).
 */
methoddecls ::=
    methoddecl:m methoddecls:ms
    {: ms.prepend(m); RESULT = ms; :}
  | /* empty */
    {: RESULT = new MethodDeclList(); :}
    ;

/**
 * Methoddecl ::= Type id ( Params ) { Fielddecls Stmts }
 *              | void id ( Params ) { Fielddecls Stmts }
 * 
 * Method declaration with:
 * - Return type (Type or void)
 * - Parameters
 * - Local variable declarations
 * - Statement body
 * 
 * Note: Optional semicolon after closing brace is handled by allowing
 *       both forms in the grammar (with and without SEMI).
 */
methoddecl ::=
    type:t ID:name LPAREN params:p RPAREN LBRACE fielddecls:v stmts:s RBRACE
    {: RESULT = new MethodDecl(t, name, p, v, s); :}
    
  | type:t ID:name LPAREN params:p RPAREN LBRACE fielddecls:v stmts:s RBRACE SEMI
    {: RESULT = new MethodDecl(t, name, p, v, s); :}
    
  | VOID ID:name LPAREN params:p RPAREN LBRACE fielddecls:v stmts:s RBRACE
    {: RESULT = new MethodDecl(name, p, v, s); :}
    
  | VOID ID:name LPAREN params:p RPAREN LBRACE fielddecls:v stmts:s RBRACE SEMI
    {: RESULT = new MethodDecl(name, p, v, s); :}
    ;

/**
 * Type ::= int | char | bool | float
 * 
 * The four basic types in the language.
 */
type ::=
    INT   {: RESULT = new Type("int"); :}
  | CHAR  {: RESULT = new Type("char"); :}
  | BOOL  {: RESULT = new Type("bool"); :}
  | FLOAT {: RESULT = new Type("float"); :}
    ;

/**
 * Params ::= ParamList | ε
 * 
 * Parameter list can be empty.
 */
params ::=
    param_list:pl
    {: RESULT = pl; :}
  | /* empty */
    {: RESULT = new ParamList(); :}
    ;

/**
 * ParamList ::= Param , ParamList | Param
 * 
 * One or more parameters separated by commas.
 * Left-recursive to build list in correct order (using prepend).
 */
param_list ::=
    param:p COMMA param_list:pl
    {: pl.prepend(p); RESULT = pl; :}
  | param:p
    {: ParamList list = new ParamList(); 
       list.add(p); 
       RESULT = list; :}
    ;

/**
 * Param ::= Type id | Type id [ ]
 * 
 * Parameter can be:
 * - Simple: int x
 * - Array: float arr[]
 */
param ::=
    type:t ID:name
    {: RESULT = new ParamDecl(t, name); :}
  | type:t ID:name LBRACKET RBRACKET
    {: RESULT = new ParamDecl(t, name, true); :}
    ;

/* ========================================================================
   PHASE 1 GRAMMAR: STATEMENTS
   (Modified: block now includes local variable declarations)
   ======================================================================== */

/**
 * Stmts ::= Stmt Stmts | ε
 * 
 * Zero or more statements.
 * Left-recursive to build list in correct order (using prepend).
 */
stmts ::=
    stmt:s stmts:ss
    {: ss.prepend(s); RESULT = ss; :}
  | /* empty */
    {: RESULT = new StmtList(); :}
    ;

/**
 * Block ::= { Fielddecls Stmts } Optionalsemi
 * 
 * PHASE 2 UPDATE: Blocks now can contain local variable declarations.
 * Optional semicolon after closing brace handled by two productions.
 */
block ::=
    LBRACE fielddecls:v stmts:s RBRACE
    {: RESULT = new BlockStmt(v, s); :}
  | LBRACE fielddecls:v stmts:s RBRACE SEMI
    {: RESULT = new BlockStmt(v, s); :}
    ;

/**
 * IfEnd ::= else Block | ε
 * 
 * Optional else clause for if statements.
 */
if_end ::=
    ELSE block:b
    {: RESULT = b; :}
  | /* empty */
    {: RESULT = null; :}
    ;

/**
 * Stmt ::= if ( Expr ) Block IfEnd
 *        | while ( Expr ) Block
 *        | Name = Expr ;
 *        | read ( Readlist ) ;
 *        | print ( Printlist ) ;
 *        | printline ( Printlinelist ) ;
 *        | id ( ) ;
 *        | id ( Args ) ;
 *        | return ;
 *        | return Expr ;
 *        | Name ++ ;
 *        | Name -- ;
 *        | Block Optionalsemi
 * 
 * All statement forms from Phase 1.
 */
stmt ::=
    /* if ( Expr ) Block IfEnd */
    IF LPAREN expr:e RPAREN block:tb if_end:eb
    {: RESULT = new IfStmt(e, tb, eb); :}

  /* while ( Expr ) Block */
  | WHILE LPAREN expr:e RPAREN block:b
    {: RESULT = new WhileStmt(e, b); :}

  /* Name = Expr ; */
  | name:n EQ expr:e SEMI
    {: RESULT = new AssignStmt(n.toString(0), e); :}

  /* read ( Readlist ) ; */
  | READ LPAREN name_list:nl RPAREN SEMI
    {: RESULT = new ReadStmt(nl); :}

  /* print ( Printlist ) ; */
  | PRINT LPAREN expr_list:el RPAREN SEMI
    {: RESULT = new PrintStmt(el); :}

  /* printline ( Printlinelist ) ; */
  | PRINTLINE LPAREN printline_args:pl RPAREN SEMI
    {: RESULT = new PrintLineStmt(pl); :}

  /* id ( ) ; */
  | ID:f LPAREN RPAREN SEMI
    {: java.util.ArrayList a = new java.util.ArrayList(); 
       RESULT = new CallStmt(f, a); :}

  /* id ( Args ) ; */
  | ID:f LPAREN expr_list:el RPAREN SEMI
    {: RESULT = new CallStmt(f, el); :}

  /* return ; */
  | RETURN SEMI
    {: RESULT = new ReturnStmt(null); :}

  /* return Expr ; */
  | RETURN expr:e SEMI
    {: RESULT = new ReturnStmt(e); :}

  /* Name ++ ; */
  | name:n INC SEMI
    {: RESULT = new IncStmt(n); :}

  /* Name -- ; */
  | name:n DEC SEMI
    {: RESULT = new DecStmt(n); :}

  /* Block Optionalsemi */
  | block:b
    {: RESULT = b; :}
    ;

/* ========================================================================
   PHASE 1 GRAMMAR: EXPRESSIONS
   (Unchanged from Phase 1)
   ======================================================================== */

/**
 * Name ::= id | id [ Expr ]
 * 
 * Variable reference or array access.
 */
name ::=
    ID:id
    {: RESULT = new VarExpr(id); :}
  | ID:id LBRACKET expr:e RBRACKET
    {: RESULT = new ArrayAccessExpr(id, e); :}
    ;

/**
 * Readlist ::= Name , Readlist | Name
 * 
 * One or more names for read statement.
 */
name_list ::=
    name:n
    {:
       java.util.ArrayList list = new java.util.ArrayList();
       list.add(n);
       RESULT = list;
     :}
  | name:n COMMA name_list:nl
    {:
       nl.add(0, n);
       RESULT = nl;
     :}
    ;

/**
 * Exprlist ::= Expr , Exprlist | Expr
 * 
 * One or more expressions for function arguments, print, etc.
 */
expr_list ::=
    expr:e
    {:
       java.util.ArrayList list = new java.util.ArrayList();
       list.add(e);
       RESULT = list;
     :}
  | expr:e COMMA expr_list:el
    {:
       el.add(0, e);
       RESULT = el;
     :}
    ;

/**
 * Printlinelist ::= Printlist | ε
 * 
 * Printline can have zero or more arguments.
 */
printline_args ::=
    /* empty (printline()) */
    {:
       java.util.ArrayList list = new java.util.ArrayList();
       RESULT = list;
     :}
  | expr_list:el
    {: RESULT = el; :}
    ;

/**
 * Expr ::= literals | variables | operations | function calls | etc.
 * 
 * All expression forms from Phase 1.
 */
expr ::=
    /* Name as expression */
      name:n
        {: RESULT = n; :}

    /* Literals */
    | INTLIT:n
        {: RESULT = new IntLiteral(n); :}
    | FLOATLIT:f
        {: RESULT = new FloatLiteral(f); :}
    | CHARLIT:c
        {: RESULT = new CharLiteral(c); :}
    | STRLIT:s
        {: RESULT = new StringLiteral(s); :}
    | TRUE
        {: RESULT = new BoolLiteral("true"); :}
    | FALSE
        {: RESULT = new BoolLiteral("false"); :}

    /* Function calls as expressions: id() / id(args) */
    | ID:f LPAREN RPAREN
        {:
            java.util.ArrayList a = new java.util.ArrayList();
            RESULT = new CallExpr(f, a);
         :}
    | ID:f LPAREN expr_list:el RPAREN
        {: RESULT = new CallExpr(f, el); :}

    /* Parentheses */
    | LPAREN expr:e RPAREN
        {: RESULT = e; :}

    /* Unary ops: -x, +x, ~x */
    | MINUS expr:e
        {: RESULT = new UnaryExpr("-", e); :}
    | PLUS expr:e
        {: RESULT = new UnaryExpr("+", e); :}
    | NOT expr:e
        {: RESULT = new UnaryExpr("~", e); :}

    /* Binary arithmetic / relational / logical ops */
    | expr:e1 MULT expr:e2
        {: RESULT = new BinaryExpr(e1, "*",  e2); :}
    | expr:e1 DIV expr:e2
        {: RESULT = new BinaryExpr(e1, "/",  e2); :}
    | expr:e1 PLUS expr:e2
        {: RESULT = new BinaryExpr(e1, "+",  e2); :}
    | expr:e1 MINUS expr:e2
        {: RESULT = new BinaryExpr(e1, "-",  e2); :}
    | expr:e1 LT expr:e2
        {: RESULT = new BinaryExpr(e1, "<",  e2); :}
    | expr:e1 LE expr:e2
        {: RESULT = new BinaryExpr(e1, "<=", e2); :}
    | expr:e1 GT expr:e2
        {: RESULT = new BinaryExpr(e1, ">",  e2); :}
    | expr:e1 GE expr:e2
        {: RESULT = new BinaryExpr(e1, ">=", e2); :}
    | expr:e1 EQEQ expr:e2
        {: RESULT = new BinaryExpr(e1, "==", e2); :}
    | expr:e1 NE expr:e2
        {: RESULT = new BinaryExpr(e1, "<>", e2); :}
    | expr:e1 AND expr:e2
        {: RESULT = new BinaryExpr(e1, "&&", e2); :}
    | expr:e1 OR expr:e2
        {: RESULT = new BinaryExpr(e1, "||", e2); :}

    /* Cast: (Type) Expr */
    | LPAREN type_name:t RPAREN expr:e
        {: RESULT = new CastExpr(t, e); :}

    /* Ternary: (cond ? then : else) */
    | LPAREN expr:c QMARK expr:t COLON expr:e2 RPAREN
        {: RESULT = new TernaryExpr(c, t, e2); :}
    ;

/**
 * TypeName ::= int | float | bool | char
 * 
 * Type names for cast expressions (returns String, not Type object).
 * This is separate from the 'type' production which returns Type objects.
 */
type_name ::=
    INT   {: RESULT = "int"; :}
  | FLOAT {: RESULT = "float"; :}
  | BOOL  {: RESULT = "bool"; :}
  | CHAR  {: RESULT = "char"; :}
    ;

